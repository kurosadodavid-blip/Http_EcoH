# Copia este archivo como .env para pruebas locales.
# En Render, agrega DATABASE_URL en Environment y pega el Internal Database URL
# de tu base de datos PostgreSQL de Render.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/NOMBRE_BASE

# Genera una clave aleatoria larga. No uses el valor de ejemplo en producción.
SECRET_KEY=CAMBIA_POR_UNA_CLAVE_ALEATORIA_LARGA
ACCESS_TOKEN_MINUTES=1440

# Para una app web, reemplaza * por los dominios permitidos separados por comas.
CORS_ORIGINS=*
